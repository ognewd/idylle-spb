TINKOFF_SECRET_KEY="your-secret-key"

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Company Details for Bank Transfer
COMPANY_NAME="ООО Идилль"
COMPANY_INN="1234567890"
COMPANY_KPP="123456789"
COMPANY_BANK="ПАО Сбербанк"
COMPANY_BIK="044525225"
COMPANY_ACCOUNT="40702810123456789012"
COMPANY_CORRESPONDENT="30101810400000000225"

# Newsletter
SENDPULSE_API_ID="your-api-id"
SENDPULSE_API_SECRET="your-api-secret"

# СДЭК API (sdek-api-lib). Учётные данные можно задать здесь или в админке (Доставка СДЭК).
# Тестовая среда: api.edu.cdek.ru — Account = CDEK_CLIENT_ID, Secure password = CDEK_CLIENT_SECRET.
# baseUrl без /v2 (библиотека добавляет сама). Для теста: CDEK_TEST_MODE=true.
# CDEK_CLIENT_ID="your-client-id"
# CDEK_CLIENT_SECRET="your-client-secret"
# CDEK_TEST_MODE=true
# CDEK_API_TEST_URL=https://api.edu.cdek.ru
# CDEK_API_URL=https://api.cdek.ru

# Подсказки адресов (DaData). Без ключей используется fallback по ПВЗ СДЭК.
# DADATA_API_KEY="your-dadata-api-key"
# DADATA_SECRET="your-dadata-secret"
