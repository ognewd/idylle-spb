# ============================================================
# Шаблон переменных окружения
#
# Структура env-файлов:
#   .env            — несекретные дефолты (коммитится)
#   .env.local      — секреты для DEV (НЕ коммитится)
#   .env.production — секреты для PROD (только на сервере)
#
# Next.js загружает: .env → .env.local → .env.[environment]
# ============================================================

# --- База данных ---
DATABASE_URL="postgresql://username:password@localhost:5432/idylle_spb"

# --- NextAuth.js ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key"

# --- Загрузка файлов ---
# Прод: UPLOADS_DIR="/var/www/uploads"
# Dev: оставить пустым (используется public/uploads)
UPLOADS_DIR=""

# --- Платёжный шлюз БСПБ (Банк Санкт-Петербург) ---
# Тест:  BSPB_API_URL="https://pgtest.bspb.ru:5443"
# Прод:  BSPB_API_URL="https://pg.bspb.ru:5443"
# BSPB_AUTH_BASIC = base64("login:password")
# Сертификаты (PEM + KEY) — в папку /certs/ (в .gitignore)
BSPB_API_URL="https://pgtest.bspb.ru:5443"
BSPB_AUTH_BASIC="base64-encoded-login:password"
BSPB_HPP_REDIRECT_URL="https://idylle.spb.ru/payment/result"
BSPB_CERT_FILE="pgtest_cer_2026.pem"
BSPB_KEY_FILE="pgtest_key.key"

# --- СДЭК ---
# Тест: api.edu.cdek.ru (CDEK_TEST_MODE=true)
# Прод: api.cdek.ru (CDEK_TEST_MODE=false)
# Креды также можно задать через админку: /admin/delivery
CDEK_CLIENT_ID="your-client-id"
CDEK_CLIENT_SECRET="your-client-secret"
CDEK_TEST_MODE=true
CDEK_API_TEST_URL=https://api.edu.cdek.ru
CDEK_API_URL=https://api.cdek.ru

# --- DaData (подсказки адресов) ---
# Без ключей используется fallback по ПВЗ СДЭК
DADATA_API_KEY="your-dadata-api-key"
DADATA_SECRET="your-dadata-secret"

# --- Email (SMTP) ---
# Заказы: уведомления о заказе (как раньше)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Партнёры: письма с логином в кабинет (если не задано — fallback на SMTP_*)
PARTNER_SMTP_HOST=""
PARTNER_SMTP_PORT=""
PARTNER_SMTP_USER=""
PARTNER_SMTP_PASS=""
PARTNER_SMTP_FROM=""

# --- Реквизиты компании (для безналичного расчёта) ---
COMPANY_NAME="ООО Идилль"
COMPANY_INN="1234567890"
COMPANY_KPP="123456789"
COMPANY_BANK="ПАО Сбербанк"
COMPANY_BIK="044525225"
COMPANY_ACCOUNT="40702810123456789012"
COMPANY_CORRESPONDENT="30101810400000000225"

# --- Рассылки ---
SENDPULSE_API_ID="your-api-id"
SENDPULSE_API_SECRET="your-api-secret"

# --- Яндекс.Карты (для виджета СДЭК) ---
NEXT_PUBLIC_YANDEX_MAPS_API_KEY="your-yandex-maps-key"
