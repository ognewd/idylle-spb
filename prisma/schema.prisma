generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String         @id @default(cuid())
  email                String         @unique
  name                 String?
  phone                String?
  password             String
  role                 String         @default("user")
  isActive             Boolean        @default(true)
  unsubscribed         Boolean        @default(false) // Отписка от маркетинговых писем
  marketingConsent     String?        // "granted" | "denied" | null
  marketingConsentAt   DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  termsAcceptedAt      DateTime?
  privacyAcceptedAt    DateTime?
  allowedAdminSections String[]       @default([])
  addresses            Address[]
  orders               Order[]
  reviews              Review[]
  wishlist             WishlistItem[]
  createdTasks         Task[]           @relation("TaskCreator")
  assignedTasks        Task[]           @relation("TaskAssignee")
  taskMessages          TaskMessage[]    @relation("TaskMessageAuthor")

  @@map("users")
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  name       String
  street     String
  city       String
  postalCode String
  country    String   @default("Russia")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("addresses")
}

model Category {
  id                         String                     @id @default(cuid())
  name                       String
  slug                       String                     @unique
  description                String?
  pageContent                String?                    @db.Text // HTML контент страницы категории
  parentId                   String?
  image                      String?
  sortOrder                  Int                        @default(0)
  isActive                   Boolean                    @default(true)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  parent                     Category?                  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children                   Category[]                 @relation("CategoryHierarchy")
  productCategories          ProductCategory[]
  seasonalDiscountCategories SeasonalDiscountCategory[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  logo        String?
  website     String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]

  @@map("brands")
}

model Product {
  id                String                    @id @default(cuid())
  name              String                    // Полное название
  shortName         String?                   // Краткое название (для H1)
  slug              String                    @unique
  description       String?
  shortDescription  String?
  price             Decimal                   @db.Decimal(10, 2)
  comparePrice      Decimal?                  @db.Decimal(10, 2)
  sku               String?                   @unique
  volume            String?
  gender            String?
  aromaFamily       String?
  ingredients       String?
  isActive          Boolean                   @default(true)
  isFeatured        Boolean                   @default(false)
  stock             Int                       @default(0)
  weight            Decimal?                  @db.Decimal(8, 2)
  dimensions        String?
  // Импорт из Мой склад
  myWarehouseCode   String?                   @unique // Код Мой склад - главный ID для обновления
  manufacturerSku   String? // Артикул производителя
  productType       String? // Вид товара (для фильтра)
  aromaDescription  String? // Описание аромата
  topNotes          String? // Основные ноты
  purpose           String? // Назначение (Для какого помещения)
  usageInstructions String? @db.Text // Способ применения
  brandCountry      String? // Страна происхождения бренда
  manufactureCountry String? // Страна производства
  barcode           String? // Штрихкод
  warehouseLocation String? // Место товара (только для админки, не показывать на фронте)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  brandId           String
  orderItems        OrderItem[]
  productCategories ProductCategory[]
  images            ProductImage[]
  variants          ProductVariant[]
  brand             Brand                     @relation(fields: [brandId], references: [id])
  reviews           Review[]
  seasonalDiscounts SeasonalDiscountProduct[]
  wishlist          WishlistItem[]

  @@index([myWarehouseCode])
  @@map("products")
}

model ProductCategory {
  id         String   @id @default(cuid())
  productId  String
  categoryId String
  isPrimary  Boolean  @default(false)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
  @@map("product_categories")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  name         String
  value        String
  price        Decimal? @db.Decimal(10, 2)
  comparePrice Decimal? @db.Decimal(10, 2)
  stock        Int      @default(0)
  sku          String?
  isDefault    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  userId          String?
  status          String      @default("pending")
  paymentStatus   String      @default("pending")
  paymentMethod   String
  deliveryMethod  String      @default("delivery")
  firstName       String
  lastName        String
  email           String
  phone           String
  city            String?
  deliveryAddress String?
  companyName     String?
  inn             String?
  kpp             String?
  companyAddress  String?
  subtotal        Decimal     @db.Decimal(10, 2)
  tax             Decimal     @default(0) @db.Decimal(10, 2)
  shipping        Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  total           Decimal     @db.Decimal(10, 2)
  notes           String?     // Комментарий к заказу
  courierComment  String?     // Комментарий для курьера
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  addressId       String?
  items           OrderItem[]
  address         Address?    @relation(fields: [addressId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])
  
  // Поля СДЕК
  cdekOrderUuid        String?   // UUID заказа в системе СДЕК
  cdekOrderNumber      String?   // Номер заказа СДЕК
  cdekTariffCode       Int?      // Код тарифа (139, 138 и т.д.)
  cdekTariffName       String?   // Название тарифа
  cdekDeliveryType     String?   // "door" | "pvz"
  cdekPvzCode          String?   // Код ПВЗ (если выбрана доставка в ПВЗ)
  cdekPvzAddress       String?   // Адрес ПВЗ
  cdekDeliveryCost     Decimal?  @db.Decimal(10, 2) // Стоимость доставки
  cdekDeliveryDateMin  DateTime? // Минимальная дата доставки
  cdekDeliveryDateMax  DateTime? // Максимальная дата доставки
  cdekStatus           String?   // Статус в системе СДЕК
  cdekStatusUpdatedAt  DateTime? // Когда последний раз обновлялся статус

  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  productName String
  quantity    Int
  price       Decimal  @db.Decimal(10, 2)
  variantInfo String?
  createdAt   DateTime @default(now())
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id         String   @id @default(cuid())
  userId     String?  // Опционально для анонимных отзывов
  productId  String
  rating     Int
  title      String?
  comment    String?
  userName   String?  // Имя для анонимных отзывов
  userEmail  String?  // Email для анонимных отзывов
  isVerified Boolean  @default(false)
  isApproved Boolean  @default(false) // Модерация отзывов
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model Newsletter {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  subscribedAt   DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("newsletter")
}

model PaymentMethod {
  id           String   @id @default(cuid())
  name         String
  type         String
  isActive     Boolean  @default(true)
  commission   Decimal  @default(0) @db.Decimal(5, 2)
  instructions String?
  config       Json?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("payment_methods")
}

model FilterGroup {
  id        String         @id @default(cuid())
  name      String
  type      String
  isActive  Boolean        @default(true)
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  options   FilterOption[]

  @@map("filter_groups")
}

model FilterOption {
  id            String      @id @default(cuid())
  filterGroupId String
  name          String
  value         String
  sortOrder     Int         @default(0)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  filterGroup   FilterGroup @relation(fields: [filterGroupId], references: [id], onDelete: Cascade)

  @@map("filter_options")
}

model SeasonalDiscount {
  id         String                     @id @default(cuid())
  name       String
  discount   Int
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean                    @default(true)
  applyTo    String                     @default("categories")
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  categories SeasonalDiscountCategory[]
  products   SeasonalDiscountProduct[]

  @@map("seasonal_discounts")
}

model SeasonalDiscountCategory {
  id         String           @id @default(cuid())
  discountId String
  categoryId String
  createdAt  DateTime         @default(now())
  category   Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  discount   SeasonalDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)

  @@unique([discountId, categoryId])
  @@map("seasonal_discount_categories")
}

model SeasonalDiscountProduct {
  id         String           @id @default(cuid())
  discountId String
  productId  String
  createdAt  DateTime         @default(now())
  discount   SeasonalDiscount @relation(fields: [discountId], references: [id], onDelete: Cascade)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountId, productId])
  @@map("seasonal_discount_products")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("string")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model Page {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  content       String?  @db.Text // HTML контент или JSON для блоков
  metaTitle     String?
  metaDescription String? @db.Text
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("pages")
}

model ChatSession {
  id          String        @id @default(cuid())
  userId      String?
  userName    String
  userEmail   String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  lastMessage DateTime?
  messages    ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(cuid())
  chatId      String
  sender      String // "user" or "admin"
  message     String
  isRead      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  chatSession ChatSession @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model Task {
  id          String        @id @default(cuid())
  title       String
  description String?        @db.Text
  status      String        @default("new") // "new", "in_progress", "review", "done"
  priority    String        @default("normal") // "urgent", "normal", "someday"
  createdById String
  assignedToId String?      // Назначенный пользователь
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   User          @relation("TaskCreator", fields: [createdById], references: [id])
  assignedTo  User?         @relation("TaskAssignee", fields: [assignedToId], references: [id])
  files       TaskFile[]
  messages    TaskMessage[]

  @@map("tasks")
}

model TaskFile {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  fileName  String
  fileType  String?  // MIME type: application/vnd.openxmlformats-officedocument.wordprocessingml.document, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, etc.
  fileSize  Int?     // Размер файла в байтах
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_files")
}

model TaskMessage {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  message   String?  @db.Text
  fileUrl   String?
  fileName  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation("TaskMessageAuthor", fields: [userId], references: [id])

  @@map("task_messages")
}

// Email Marketing Models
model EmailTemplate {
  id            String          @id @default(cuid())
  type          String          // "SERVICE" | "MARKETING"
  name          String
  subjectDefault String?
  designJson    Json?           // Структура конструктора (блоки)
  html          String?         @db.Text // Кэшированный HTML
  status        String          @default("draft") // "draft" | "active" | "archived"
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  campaigns     EmailCampaign[]

  @@index([type, status])
  @@map("email_templates")
}

model EmailCampaign {
  id          String                   @id @default(cuid())
  name        String
  templateId  String
  subject     String
  preheader   String?
  status      String                   @default("draft") // "draft" | "scheduled" | "sending" | "sent" | "failed" | "canceled"
  scheduledAt DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  statsTotal  Int                      @default(0)
  statsSent   Int                      @default(0)
  statsFailed Int                      @default(0)
  statsOpened Int                      @default(0)
  statsClicked Int                     @default(0)
  filterJson  Json?                    // Фильтры получателей
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  template    EmailTemplate            @relation(fields: [templateId], references: [id], onDelete: Restrict)
  recipients  EmailCampaignRecipient[]

  @@index([status, scheduledAt])
  @@map("email_campaigns")
}

model EmailCampaignRecipient {
  id          String         @id @default(cuid())
  campaignId  String
  userId      String?
  email       String
  status      String         @default("pending") // "pending" | "sent" | "failed" | "skipped"
  errorMessage String?       @db.Text
  openedAt    DateTime?
  clickedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  campaign    EmailCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, status])
  @@index([email])
  @@map("email_campaign_recipients")
}

model EmailUnsubscribe {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  reason    String?  @db.Text
  token     String   @unique
  createdAt DateTime @default(now())

  @@index([email])
  @@map("email_unsubscribes")
}
